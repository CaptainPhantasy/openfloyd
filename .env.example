# ===========================================
# OPEN-FLOYD COO Platform — Environment Configuration
# ===========================================
# Copy this file to .env and fill in values

# --- LLM Providers ---
ZAI_API_KEY=your_api_key_here
GLM_MODEL=glm-5-turbo
GLM_FALLBACK_MODEL=glm-4.7
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Web Research ---
EXA_API_KEY=
TAVILY_API_KEY=

# --- External MCP Integrations ---
RUBE_MCP_URL=https://rube.app/mcp
RUBE_MCP_TOKEN=

# --- Email Outbound (SMTP + strict allowlist) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=floyd@legacyai.space
SMTP_PASS=
SMTP_FROM=floyd@legacyai.space
EMAIL_ALLOWED_RECIPIENTS=douglas@floydlabs.com,douglas.talley@legacyai.space

# --- Email Inbound (IMAP, optional) ---
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=floyd@legacyai.space
IMAP_PASS=
EMAIL_ALLOWED_SENDERS=douglas@floydlabs.com,douglas.talley@legacyai.space

# --- WhatsApp ---
WHATSAPP_SESSION_NAME=openfloyd
WHATSAPP_ALLOWED_NUMBERS=+1234567890

# --- Memory ---
SQLITE_DB_PATH=/app/workspace/memory.db
REDIS_URL=redis://redis:6379

# --- Security (WASM Extism Config) ---
SANDBOX_TIMEOUT=5000
SANDBOX_MEMORY_BYTES=268435456

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- Deployment ---
NODE_ENV=development
PORT=8787

# Security note:
# Never commit real MCP tokens. Keep RUBE_MCP_TOKEN only in local/secret env stores.

# --- VibeBox Workers ---
VIBEBOX_SSH_KEY=/Volumes/SanDisk1gb/floyd-sandbox/.vibebox/ssh_key
WORKER_IMAGE=openfloyd-worker:latest

# --- GitHub Delivery ---
GITHUB_PAT=                       # Personal Access Token with repo + org scope
GITHUB_ORG=LegacyAI-FloydsLabs   # Target GitHub organization

# --- Budget ---
DAILY_BUDGET=10.00
