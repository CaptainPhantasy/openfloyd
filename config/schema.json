{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OPEN-FLOYD System Configuration",
  "type": "object",
  "required": ["system", "models", "agents"],
  "properties": {
    "system": {
      "type": "object",
      "required": ["version", "logLevel"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "logLevel": { "type": "string", "enum": ["trace", "debug", "info", "warn", "error", "fatal"] }
      }
    },
    "models": {
      "type": "object",
      "required": ["providers"],
      "properties": {
        "providers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["apiKey"],
            "properties": {
              "apiKey": { "type": "string" },
              "baseUrl": { "type": "string", "format": "uri" },
              "models": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "name"],
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "reasoning": { "type": "boolean" },
                    "input": { "type": "array", "items": { "type": "string" } },
                    "contextWindow": { "type": "integer", "minimum": 1 },
                    "maxTokens": { "type": "integer", "minimum": 1 },
                    "cost": {
                      "type": "object",
                      "properties": {
                        "input": { "type": "number", "minimum": 0 },
                        "output": { "type": "number", "minimum": 0 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "required": ["defaults"],
      "properties": {
        "defaults": {
          "type": "object",
          "properties": {
            "model": {
              "type": "object",
              "properties": {
                "primary": { "type": "string" },
                "fallbacks": { "type": "array", "items": { "type": "string" } }
              }
            },
            "memory": {
              "type": "object",
              "properties": {
                "strategy": { "type": "string", "enum": ["discard-all", "sliding-window", "summarize", "hybrid"] },
                "retentionLimit": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "properties": {
        "whatsapp": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "allowedNumbers": { "type": "array", "items": { "type": "string" } },
            "autoReply": { "type": "boolean" }
          }
        }
      }
    }
  }
}
